# ─────────────────────────────────────────────────────────────────────────────
# Environment for the Docker stack. Copy to  .env  and fill in real values.
#   cp .env.docker.example .env
# The .env file is git-ignored — never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# OFF in production.
DJANGO_DEBUG=False

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME_to_a_long_random_string

# Hostnames Django answers to. "backend" is the in-network name used by nginx.
DJANGO_ALLOWED_HOSTS=hr.rdi.world,localhost,127.0.0.1,backend

# Absolute URLs for sitemap.xml, robots.txt and the crawler route.
SITE_DOMAIN=hr.rdi.world
SITE_PROTOCOL=https

# Browser origins allowed to call the API / submit forms.
CORS_ALLOWED_ORIGINS=https://hr.rdi.world
CSRF_TRUSTED_ORIGINS=https://hr.rdi.world

# Super admin, seeded on first migrate. CHANGE THE PASSWORD.
DJANGO_SUPERADMIN_EMAIL=hr@rdi.com
DJANGO_SUPERADMIN_PASSWORD=CHANGE_ME_strong_password
DJANGO_SUPERADMIN_USERNAME=Rupani Development Initiatives

# Email for job alerts (console just logs; switch to SMTP to actually send).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=RDI Job Portal <no-reply@rdi.world>
