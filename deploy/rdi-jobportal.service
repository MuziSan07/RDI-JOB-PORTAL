# systemd service that runs the Django backend under gunicorn.
# Install to: /etc/systemd/system/rdi-jobportal.service
#
#   sudo cp deploy/rdi-jobportal.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rdi-jobportal
#
# Adjust the paths below if you cloned somewhere other than /var/www/rdi-job-portal.

[Unit]
Description=RDI Job Portal (Django / gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/rdi-job-portal/backend
EnvironmentFile=/var/www/rdi-job-portal/backend/.env
ExecStart=/var/www/rdi-job-portal/venv/bin/gunicorn job_portal.wsgi:application \
    --workers 3 \
    --bind 127.0.0.1:8001 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
