# ─────────────────────────────────────────────────────────────────────────────
# Production environment for the Django backend.
# Copy this to  backend/.env  on the server and fill in the real values.
# NEVER commit the filled-in .env — it is git-ignored on purpose.
# ─────────────────────────────────────────────────────────────────────────────

# Turn debug OFF in production.
DJANGO_DEBUG=False

# A long random secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME_to_a_long_random_string

# Hostnames Django will answer to.
DJANGO_ALLOWED_HOSTS=hr.rdi.world,144.91.102.242

# Absolute URLs in sitemap.xml, robots.txt and the crawler route.
SITE_DOMAIN=hr.rdi.world
SITE_PROTOCOL=https

# Browser origins allowed to call the API / submit forms.
CORS_ALLOWED_ORIGINS=https://hr.rdi.world
CSRF_TRUSTED_ORIGINS=https://hr.rdi.world

# Django's own static files live under this prefix so they never clash with the
# React build (which also serves assets under /static/).
DJANGO_STATIC_URL=/django-static/

# Super admin, seeded automatically on the first `migrate`. CHANGE THE PASSWORD.
DJANGO_SUPERADMIN_EMAIL=hr@rdi.com
DJANGO_SUPERADMIN_PASSWORD=CHANGE_ME_strong_password
DJANGO_SUPERADMIN_USERNAME=Rupani Development Initiatives

# Email for job alerts. Console backend just prints to the log; switch to SMTP
# with real credentials when you want alerts actually delivered.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=RDI Job Portal <no-reply@rdi.world>
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
